# 不要提交 .env。主网 API Key 只应有「读取」和「合约交易」权限，并绑定服务器固定 IP。
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Gmail SMTP 邮件通知（使用 Gmail 应用专用密码；不要使用账户登录密码）。
# 部署人员在服务器 .env 中填写凭据；不要提交真实密码。
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@example.com
SMTP_APP_PASSWORD=your-gmail-app-password
EMAIL_TO=recipient@example.com

# Testnet=true；主网=false。它必须与 EXECUTION_MODE 对应，防止连错环境。
BINANCE_TESTNET=true
# 执行模式：paper 为本地模拟；binance_testnet / binance_mainnet 为 Binance USDⓈ-M。
EXECUTION_MODE=paper
# Binance API 请求超时窗口，单位毫秒。10 秒可容忍 Testnet 的短暂时钟/网络抖动。
BINANCE_RECV_WINDOW=10000
# 中性网格需要开启双向持仓（Hedge Mode），程序只校验，不会自动修改。
BINANCE_HEDGE_MODE_REQUIRED=true

# 以下策略和风控参数仅在首次启动时迁移至 runtime/state.sqlite3 的 strategy_config 表。
# 此后仪表盘写入该表，修改 .env 中的这些值不会影响运行。
# 交易对与网格区间。
SYMBOL=BTCUSDT
# 网格价格下限与上限；当前标记价和参考价必须严格处于此区间内。
GRID_LOWER_PRICE=90000
GRID_UPPER_PRICE=110000
# 将价格区间划分为多少格；等差模式下每格间距 =（上限 - 下限）/ 网格数量。
GRID_COUNT=20
# 网格间距：arithmetic=等差，geometric=等比。
GRID_SPACING=arithmetic
# 由控制台根据“本次网格投入”、杠杆、首批订单数及 Testnet 合约规则自动计算。
# 请勿手动设置；保留此字段供机器人执行下单。
ORDER_NOTIONAL_USDT=25
# 合约杠杆倍数；总投入保证金 × 杠杆会分配到首批开仓单。
LEVERAGE=2
# 用于划分多/空挂单的参考价；启动时须接近当前标记价。
START_REFERENCE_PRICE=100000
# 本次网格投入的总保证金，也是策略权益和 ROI 的计算基准。
INITIAL_CAPITAL_USDT=1000

# 风控阈值均以小数 ROI 填写：0.30 = 30%，-0.20 = -20%。
# ROI 到达此负值时立即止损、撤单并平仓。
HARD_STOP_LOSS_ROI=-0.20
# ROI 曾达到此值后启动保本保护；回落至下方的“保本退出 ROI”即退出。
BREAKEVEN_ARM_ROI=0.15
# 启动保本保护后的退出阈值。
BREAKEVEN_FLOOR_ROI=0.10
# ROI 曾达到此值后启动追踪止盈。
TRAILING_ARM_ROI=0.30
# 追踪止盈启动后，ROI 从历史峰值回撤此幅度即退出。
TRAILING_DRAWDOWN_ROI=0.08

# 运行状态文件与轮询间隔（秒）。账户权益使用 REST 查询；不要低于 10 秒以避免限流。
STATE_FILE=runtime/state.json
LOOP_INTERVAL_SECONDS=10
# true 仅验证 Binance 账户后退出，不挂单；false 才允许进入运行循环。
DRY_RUN=true
# 第二道安全开关；仅在确认要向 Binance 提交订单时设为 true。
RUNNER_ENABLED=false
# 主网且 DRY_RUN=false 时必须逐字填写此确认值；测试网/Paper 不需要。
LIVE_TRADING_CONFIRMATION=
